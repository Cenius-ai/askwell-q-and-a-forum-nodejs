# Askwell Q and A Forum — example environment.
# Every value is optional: the app boots with working development defaults and
# reads these variables straight from the process environment (no .env loader).
# Copy this file to .env only if you want to change them for a deployment.

# HTTP port the Express server binds. Default: 3000.
PORT=3000

# Interface to bind. Default: 0.0.0.0 (reachable from outside the container).
HOST=0.0.0.0

# Secret used to sign the session cookie. Leave empty and the app generates one
# random 32-byte secret on first boot, stored next to the database in
# data/.session-secret. Set it explicitly when you run more than one process.
SESSION_SECRET=

# SQLite file, relative to the project root. Default: ./data/askwell.db
ASKWELL_DB=./data/askwell.db

# development | production. Only affects static asset caching.
NODE_ENV=development
