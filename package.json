{
  "name": "askwell-q-and-a-forum",
  "version": "1.0.0",
  "private": true,
  "description": "Askwell Q and A Forum \u2014 a self-hosted, server-rendered Q&A community (Apache Answer-style) built with Express, EJS and SQLite.",
  "main": "server.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "src",
      "views",
      "public"
    ],
    "ignore": [
      "data",
      "node_modules",
      "tests"
    ],
    "delay": 150
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.10.0",
    "ejs": "3.1.10",
    "express": "4.19.2",
    "express-session": "1.18.0",
    "helmet": "7.1.0"
  },
  "devDependencies": {
    "nodemon": "3.1.7",
    "supertest": "7.1.3"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "path-to-regexp": "0.1.13"
  }
}
