<section class="error-page panel">
  <p class="error-page__code">500</p>
  <h1 class="error-page__title">Something went wrong on our side</h1>
  <p class="error-page__text"><%= typeof message !== 'undefined' && message ? message : 'The error has been logged. Reload the page or head back to the question list.' %></p>
  <div class="error-page__actions">
    <a class="btn btn-primary" href="/">Back to questions</a>
    <a class="btn btn-ghost" href="/dashboard">Your dashboard</a>
  </div>
</section>
