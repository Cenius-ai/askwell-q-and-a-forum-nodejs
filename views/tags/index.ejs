<section class="page-head">
  <p class="eyebrow">Find your people</p>
  <h1>Tags</h1>
  <p class="lede">Tags are how the community routes questions to the people who can answer them. Follow the ones you watch.</p>
</section>

<% if (tags.length === 0) { %>
  <div class="panel empty">
    <p class="empty__title">No tags yet</p>
    <p class="empty__text">Tags are created when the first question uses them.</p>
    <a class="btn btn-primary btn-sm" href="/questions/new">Ask a question</a>
  </div>
<% } else { %>
  <div class="tag-grid">
    <% tags.forEach(function (tag) { %>
      <article class="tag-card panel">
        <div class="tag-card__head">
          <a class="tag-card__name" href="/tags/<%= tag.slug %>">#<%= tag.name %></a>
        </div>
        <p class="tag-card__desc"><%= tag.description || 'No description yet — the questions define it.' %></p>
        <div class="tag-card__foot">
          <span class="tag-card__counts">
            <span class="count-pill"><strong><%= tag.question_count %></strong> question<%= tag.question_count === 1 ? '' : 's' %></span>
            <span class="count-pill"><strong><%= tag.followers %></strong> follower<%= tag.followers === 1 ? '' : 's' %></span>
          </span>
          <% if (user) { %>
            <form method="post" action="/tags/<%= tag.id %>/follow" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="returnTo" value="/tags">
              <button class="btn btn-sm <%= followedIds.has(tag.id) ? 'btn-ghost is-following' : 'btn-quiet' %>" type="submit">
                <%= followedIds.has(tag.id) ? 'Following' : 'Follow' %>
              </button>
            </form>
          <% } else { %>
            <a class="btn btn-quiet btn-sm" href="/login?next=%2Ftags">Follow</a>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>
