<a class="tag-chip<%= typeof extraClass !== 'undefined' && extraClass ? ' ' + extraClass : '' %>" href="/tags/<%= tag.slug %>">
  <span class="tag-chip__name"><%= tag.name %></span><% if (typeof count !== 'undefined' && count !== null) { %><span class="tag-chip__count"><%= count %></span><% } %>
</a>
