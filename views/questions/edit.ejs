<section class="page-head">
  <p class="eyebrow"><a href="/questions/<%= question.id %>">Back to the question</a></p>
  <h1>Edit question</h1>
  <p class="lede">Only the author can edit. Edits keep the discussion above intact.</p>
</section>

<form class="panel form" method="post" action="/questions/<%= question.id %>" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="field<%= errors.title ? ' field--invalid' : '' %>">
    <label class="label" for="title">Title</label>
    <input class="input input--title" id="title" name="title" type="text" value="<%= values.title %>"
           maxlength="140" required <%= errors.title ? 'aria-invalid="true" aria-describedby="title-error"' : '' %>>
    <% if (errors.title) { %><p class="field-error" id="title-error"><%= errors.title %></p><% } %>
  </div>

  <div class="field<%= errors.body ? ' field--invalid' : '' %>">
    <label class="label" for="body">Question body</label>
    <textarea class="input textarea" id="body" name="body" rows="10" required
              <%= errors.body ? 'aria-invalid="true" aria-describedby="body-error"' : '' %>><%= values.body %></textarea>
    <% if (errors.body) { %><p class="field-error" id="body-error"><%= errors.body %></p><% } %>
  </div>

  <div class="field<%= errors.tags ? ' field--invalid' : '' %>">
    <label class="label" for="tags">Tags</label>
    <input class="input" id="tags" name="tags" type="text" value="<%= values.tags %>" autocomplete="off"
           <%= errors.tags ? 'aria-invalid="true" aria-describedby="tags-error"' : '' %>>
    <% if (errors.tags) { %>
      <p class="field-error" id="tags-error"><%= errors.tags %></p>
    <% } else { %>
      <p class="hint">Comma separated, up to 5.</p>
    <% } %>
  </div>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Save changes</button>
    <a class="btn btn-ghost" href="/questions/<%= question.id %>">Cancel</a>
  </div>
</form>
